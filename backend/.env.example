# Postgres (matches docker-compose.yml; host port 5433 to avoid local clashes)
DATABASE_URL=postgresql://cuatro:cuatro@localhost:5433/cuatro?schema=public

# Session
SESSION_SECRET=replace-me-with-a-long-random-string

# OAuth (Google only — GitHub dropped, email/password handled separately)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment pivot
QR_SIGNING_SECRET=          # openssl rand -hex 32
BANK_ACCOUNT_REF=Banco Atlántida · Cuenta 0000000000 · Cuatro Films
BANK_ACCOUNT_NUMBER=          # destination account number the verifier gates on (digits only)
PAYMENT_ARCHIVE_EMAIL=pagos@cuatro.example
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# Error monitoring (optional — leave blank to disable)
SENTRY_DSN=

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Server
PORT=4000
NODE_ENV=development
