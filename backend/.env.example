# Postgres (matches docker-compose.yml; host port 5433 to avoid local clashes)
DATABASE_URL=postgresql://cuatro:cuatro@localhost:5433/cuatro?schema=public

# Session
SESSION_SECRET=replace-me-with-a-long-random-string

# OAuth (Google only — GitHub dropped, email/password handled separately)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email
RESEND_API_KEY=

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Server
PORT=4000
NODE_ENV=development
