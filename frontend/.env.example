# Backend API base URL (used by server components)
API_URL=http://localhost:4000

# Public backend URL — leave blank to use same-origin via Next rewrite
NEXT_PUBLIC_BACKEND_URL=

# Bank account reference displayed on checkout
NEXT_PUBLIC_BANK_ACCOUNT_REF=

# Error monitoring (optional — leave blank to disable Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
